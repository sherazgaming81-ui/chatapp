# ═══════════════════════════════════════════════════════════════════════════
# ChatsApp — environment variables (sirf NAAM hain, values NAHI)
# Asal values Vercel project → Settings → Environment Variables me dalo.
# Secrets KABHI chat me mat bhejo, code me mat likho.
# ═══════════════════════════════════════════════════════════════════════════

# Supabase (pehle se istemal ho rahi hain)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key — SIRF server routes ke liye (RLS bypass).
# Supabase Dashboard → Project Settings → API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY=

# ── Connect Threads (Meta Threads API) ─────────────────────────────────────
# Meta developer app ki App ID / App Secret (developers.facebook.com).
THREADS_APP_ID=
THREADS_APP_SECRET=
# OAuth redirect URI — Meta app me bilkul yehi URI add karna hai:
# https://chatapp0071.vercel.app/api/threads/callback
THREADS_REDIRECT_URI=https://chatapp0071.vercel.app/api/threads/callback

# Posting runner ki hifazat — khud aik lamba random secret banao.
# Cron job POST /api/posting/run ko header `x-cron-secret` me yehi bhejega.
POSTING_CRON_SECRET=
